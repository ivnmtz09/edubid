# ==========================================================
# EduBid Backend - Variables de Entorno de Ejemplo
# Copia este archivo como .env para configuración local:
# cp .env.example .env
# ==========================================================

# ----------------------------------------------------------
# CONFIGURACIÓN DJANGO
# ----------------------------------------------------------
SECRET_KEY=django-insecure-tu_clave_secreta_aqui_para_desarrollo
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------
# BASE DE DATOS (Soporte Dual: Supabase / PostgreSQL o MySQL)
# ----------------------------------------------------------
# Opción A: Supabase (PostgreSQL en la Nube - Recomendado)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.[TU_PROJECT_REF]
DB_PASSWORD=tu_contraseña_de_supabase
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_SSLMODE=require

# Opción B: MySQL local (Docker Compose)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=edubid_db
# DB_USER=edubid_user
# DB_PASSWORD=edubid_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ----------------------------------------------------------
# GOOGLE OAUTH 2.0 (Google Identity Services)
# ----------------------------------------------------------
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# ----------------------------------------------------------
# SERVICIO DE CORREO ELECTRÓNICO (SendGrid / SMTP)
# Usado para verificación de email y reseteo de contraseña
# ----------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=tu_sendgrid_api_key
DEFAULT_FROM_EMAIL=no-reply@edubid.co

# ----------------------------------------------------------
# FRONTEND & POLÍTICAS CORS
# ----------------------------------------------------------
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------
# ALMACENAMIENTO SUPABASE STORAGE (S3 COMPATIBLE)
# Para logos institucionales y avatares de usuarios
# ----------------------------------------------------------
USE_S3=False
SUPABASE_S3_ACCESS_KEY_ID=tu_s3_access_key_id
SUPABASE_S3_SECRET_ACCESS_KEY=tu_s3_secret_access_key
SUPABASE_S3_BUCKET_NAME=edubid-media
SUPABASE_S3_REGION_NAME=us-east-1
SUPABASE_S3_ENDPOINT_URL=https://gowmeguvuignrlqakewx.supabase.co/storage/v1/s3
SUPABASE_S3_CUSTOM_DOMAIN=gowmeguvuignrlqakewx.supabase.co/storage/v1/object/public/edubid-media

