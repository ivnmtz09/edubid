# ==========================================================
# EduBid Backend - Variables de Entorno de Ejemplo
# Copia este archivo como .env para configuración local:
# cp .env.example .env
# ==========================================================

# ----------------------------------------------------------
# CONFIGURACIÓN DJANGO
# ----------------------------------------------------------
SECRET_KEY=django-insecure-tu_clave_secreta_aqui_para_desarrollo
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------
# BASE DE DATOS (MySQL / Docker Compose)
# Nota: Estas mismas variables son leídas por docker-compose.yml
# ----------------------------------------------------------
DB_NAME=edubid_db
DB_USER=edubid_user
DB_PASSWORD=edubid_password
DB_HOST=127.0.0.1
DB_PORT=3306

# ----------------------------------------------------------
# GOOGLE OAUTH 2.0 (Google Identity Services)
# ----------------------------------------------------------
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# ----------------------------------------------------------
# SERVICIO DE CORREO ELECTRÓNICO (SendGrid / SMTP)
# Usado para verificación de email y reseteo de contraseña
# ----------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=tu_sendgrid_api_key
DEFAULT_FROM_EMAIL=no-reply@edubid.co

# ----------------------------------------------------------
# FRONTEND & POLÍTICAS CORS
# ----------------------------------------------------------
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:5173,http://127.0.0.1:5173
